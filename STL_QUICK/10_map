9. User Defined Key Support*****************************VVVVVVIMP
=========================================
Need either:
1. operator< overload
OR
2. Custom comparator

Why is operator< required?
std::map is implemented as a Red-Black Tree. It must be able to compare keys to decide whether to go left or right in the tree.

*******
#include <iostream>
#include <map>
#include <string>
using namespace std;

class Employee
{
public:
    int id;

    Employee(int i) : id(i) {}

    // Required by std::map
    bool operator<(const Employee& other) const
    {
        return id < other.id;
    }
};

int main()
{
    map<Employee, string> employees;

    employees[Employee(103)] = "Alice";
    employees[Employee(101)] = "Bob";
    employees[Employee(102)] = "Charlie";

    cout << "Employees:\n";

    for (const auto& emp : employees)
    {
        cout << "ID : " << emp.first.id
             << "  Name : " << emp.second << endl;
    }

    // Find employee
    Employee e(102);

    auto it = employees.find(e);

    if (it != employees.end())
    {
        cout << "\nFound Employee : "
             << it->second << endl;
    }
    else
    {
        cout << "Employee not found\n";
    }
}
*******

*****using custom compare***
#include <iostream>
#include <map>
using namespace std;

class Employee
{
public:
    int id;

    Employee(int i) : id(i) {}
};

struct CompareEmployee
{
    bool operator()(const Employee& a, const Employee& b) const
    {
        return a.id < b.id;
    }
};

int main()
{
    map<Employee, string, CompareEmployee> employees;

    employees[Employee(2)] = "Alice";
    employees[Employee(1)] = "Bob";

    for (const auto& e : employees)
    {
        cout << e.first.id << " " << e.second << endl;
    }
}
